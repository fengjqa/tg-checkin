# ====== 从 https://my.telegram.org 获取 ======
API_ID=
API_HASH=

# 首次登录需要（运行 python login.py 时使用），登录成功后可留空
# PHONE=+8613800138000

# 运行 login.py 后会输出一段字符串，填回这里
SESSION_STRING=

# 可选：签到结果通知，填写你自己的 Telegram user id 或 me（发给收藏夹）
# 获取自己的 id：向 @userinfobot 发消息即可查到
# NOTIFY_CHAT_ID=me

# 可选：通知消息精简阈值（字符数），默认 50
# 超过此长度的机器人回复，邮件/Telegram 通知只发送开头关键行
# NOTIFY_MAX_LENGTH=50

# ====== 可选：签到结果邮件通知 ======
# 启用后在签到结束时把结果汇总发送到邮箱
# 设为 true 启用，默认 false
# EMAIL_ENABLED=true
#
# SMTP 服务器配置（常见邮箱参考）：
#   Gmail:   smtp.gmail.com          端口 465 (SSL)  需用应用专用密码
#   QQ邮箱:   smtp.qq.com             端口 465 (SSL)  需用授权码
#   163邮箱:  smtp.163.com            端口 465 (SSL)  需用授权码
#   Outlook: smtp-mail.outlook.com    端口 587 (STARTTLS)
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USERNAME=your_email@qq.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@qq.com
# SMTP_FROM_NAME=TG 签到助手
# EMAIL_TO=your_email@qq.com

# ====== 可选：图片验证码识别（AI Vision API）======
# 遇到图片验证码时，用 AI 视觉模型自动识别图片内容并选择正确答案
# 支持两种提供商，二选一（或在 config.yaml 中按机器人指定 ai_provider）
#
# 方式一：Google Gemini（推荐，有免费额度）
# 从 https://aistudio.google.com/apikey 免费获取 API Key
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # 可选，也可用 gemini-2.5-flash, gemini-1.5-pro 等
#
# 方式二：OpenAI GPT-4o（识别能力更强，但收费）
# 从 https://platform.openai.com/api-keys 获取 API Key
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini        # 可选，也可用 gpt-4o, gpt-4.1-mini 等
# OPENAI_BASE_URL=https://api.openai.com/v1  # 可选，自定义 API 地址

# ====== 可选：代理配置 ======
# 在国内或受限网络环境下，需要通过代理连接 Telegram
# 留空 PROXY_HOST 则不启用代理（直连）
#
# PROXY_TYPE 支持: socks5 | socks4 | http
# 常见代理软件本地端口参考：
#   Clash   → socks5 127.0.0.1:7890
#   V2Ray   → socks5 127.0.0.1:1080  或 http 127.0.0.1:1087
#   SSR     → socks5 127.0.0.1:1080
#
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_RDNS=true
